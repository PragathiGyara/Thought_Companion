{
  "manifest_version": 3,

  "name": "Web Thought Companion",

  "version": "1.0",

  "permissions": ["storage"],

  "host_permissions": ["<all_urls>"],

  "content_scripts": [
    {
      "matches": ["<all_urls>"],

      "js": [
        "content/toolbar.js",
        "content/content.js",

        "core/storage.js",
        "core/highlight.js",
        "core/selection.js"
      ],

      "css": [
        "styles/styles.css"
      ]
    }
  ]
}